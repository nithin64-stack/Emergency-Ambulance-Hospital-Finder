<%- include('partials/header', { title: 'Register', user: null, messages }) %>
<div class="row justify-content-center">
  <div class="col-md-7">
    <div class="card shadow-sm border-0">
      <div class="card-body p-5">
        <h2 class="mb-4">Create your account</h2>
        <form action="/register" method="POST">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Full Name</label>
              <input type="text" name="name" class="form-control" required />
            </div>
            <div class="col-md-6">
              <label class="form-label">Email</label>
              <input type="email" name="email" class="form-control" required />
            </div>
            <div class="col-md-6">
              <label class="form-label">Phone</label>
              <input type="text" name="phone" class="form-control" required />
            </div>
            <div class="col-md-6">
              <label class="form-label">Password</label>
              <div class="input-group">
                <input type="password" name="password" class="form-control" required />
                <button type="button" class="btn btn-outline-secondary password-toggle-btn" aria-label="Show password">👁️</button>
              </div>
            </div>
            <div class="col-12">
              <label class="form-label">Role</label>
              <select name="role" class="form-select">
                <option value="patient">Patient</option>
                <option value="driver">Ambulance Driver</option>
              </select>
            </div>
          </div>
          <button class="btn btn-success w-100 mt-4">Register</button>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
