<%- include('partials/header', { title: 'Login', user: null, messages }) %>
<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow-sm border-0">
      <div class="card-body p-5">
        <h2 class="mb-4">Login to Emergency Finder</h2>
        <form action="/login" method="POST">
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" name="email" class="form-control" required />
          </div>
          <div class="mb-3">
            <label class="form-label">Password</label>
            <div class="input-group">
              <input type="password" name="password" class="form-control" required />
              <button type="button" class="btn btn-outline-secondary password-toggle-btn" aria-label="Show password">👁️</button>
            </div>
          </div>
          <button class="btn btn-primary w-100">Login</button>
        </form>

        <div class="mt-3 d-grid gap-2">
          <a href="/auth/google" class="btn btn-outline-danger w-100">
            <span class="me-2">G</span>Continue with Google
          </a>
        </div>

        <hr class="my-4" />
        <p class="text-center mb-0">Don't have an account? <a href="/register">Register</a></p>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
